# Copy this file to .env and fill in your own values.

# Get a free connection string from MongoDB Atlas (atlas.mongodb.com):
# 1. Create a free cluster
# 2. Database Access -> add a user with a password
# 3. Network Access -> allow your IP (or 0.0.0.0/0 for dev)
# 4. Connect -> "Drivers" -> copy the connection string below
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/ludo?retryWrites=true&w=majority

# Any long random string works. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-string

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
